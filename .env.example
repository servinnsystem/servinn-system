# Cloud Firestore application database (private service-account key file).
FIRESTORE_PROJECT_ID="your-firebase-project-id"
FIRESTORE_CREDENTIALS_FILE=".runtime/firestore-service-account.json"
FIRESTORE_DATABASE_ID="(default)"
# Django admin accounts and sessions use db.sqlite3. No PostgreSQL/Prisma URL is needed.
# Keep your existing secret key so encrypted Gmail/OAuth settings remain readable.
# DJANGO_SECRET_KEY="your-stable-secret-key"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://127.0.0.1:8000/accounts/google-callback/"
# AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET are accepted aliases.
PRIVACY_CONTROLLER_NAME="SERVINN administration"
PRIVACY_CONTACT_EMAIL="support@servinn.ph"
